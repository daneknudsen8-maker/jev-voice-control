{
  "manifest_version": 3,
  "name": "Jev Voice Control",
  "version": "0.1.0",
  "description": "Control your browser by voice, using TypeSafe's Jev model to turn speech into typed commands.",
  "permissions": ["tabs", "scripting", "activeTab"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open voice control panel"
  },
  "icons": {}
}
